<div class="tab" id="level" data-group="sheet" data-tab="level">
    <div class="inventory-list1 cut-corner">
      <select name="system.competenceschoix" class="moitie">
    {{#each competencesMetier as |m|}}
        <option
            value="{{m.id}}"
            title="{{m.biographyPlain}}"
            {{#if (eq ../system.competenceschoix m.id)}}selected{{/if}}>
            {{m.name}} (Niv {{m.system.quantity}})
        </option>
    {{/each}}
</select>
      <span class="validcompt" data-action="AddCompt">Ajouter</span>
      <table class="compt">  
      {{#each competences as |item id|}} 
        <tr class="compt type-{{item.type}} active draggable" data-item-id="{{item._id}}" title="{{item.name}} : {{stripHTML item.system.biography}}">
          <td class="img_compt"><img src="{{item.img}}"></td>
          <td class="nom_compt">{{item.name}}</td>
          <td class="eff_compt">{{stripHTML item.system.biography}}</td>
          <td class="lev_compt" title="level">{{item.system.quantity}}</td>
          <td class="con_compt"><a class="item-control item-edit" title="Edit Item" data-action="edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a><a class="item-control item-delete" title="Delete Item" data-action="delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a></td>
        </tr>
        {{/each}}
      </table>
    </div>
    <p style="text-align: center;">Info level</p>
    <div class="character-biography0 cut-corner">
        {{formInput
          systemFields.infolevel
          value=system.infolevel
          name="system.infolevel"
        }}
    </div>
</div>