<div class="tab" id="biography" data-group="sheet" data-tab="biography">
    <div class="character-biography2 cut-corner">
        {{formInput
          systemFields.biography
          value=system.biography
          name="system.biography"
        }}
    </div>
    <div class="inventory-list2 cut-corner">
      <div class="moitier vehic">
         <h3>{{localize 'Liber.Vehicule.IA.Title'}}</h3>
         <h3>{{localize 'Liber.Vehicule.Moteur.Title'}}</h3>
         <h3>{{localize 'Liber.Vehicule.Blindage.Title'}}</h3>
         <h3>{{localize 'Liber.Vehicule.Anciennete'}}</h3>
      </div>
      <div class="moitier vehic">
        {{formInput systemFields.modeleIA name="system.modeleIA" value=system.modeleIA localize=true rootId=partId type="select"}}
        {{formInput systemFields.modeleMoteur name="system.modeleMoteur" value=system.modeleMoteur localize=true rootId=partId type="select"}}
        {{formInput systemFields.modeleBlindage name="system.modeleBlindage" value=system.modeleBlindage localize=true rootId=partId type="select"}}
        {{formInput systemFields.anciennete name="system.anciennete" value=system.anciennete localize=true rootId=partId type="select"}}
      </div>
    </div>
</div>