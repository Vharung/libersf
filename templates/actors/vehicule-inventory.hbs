<div class="tab" id="inventory" data-group="sheet" data-tab="inventory">
    <div class="character-biography1 character-biography cut-corner">
        <div class="inventory-tabs vehicule ">
            <div data-action="filtrev" data-type="allv">{{localize 'Liber.Character.Inventory.All'}}</div>
            <div data-action="filtrev" data-type="weaponvehicule">{{localize 'Liber.Character.Inventory.Weapon'}} : {{actor.system.arme}} / {{actor.system.maxarme}}</div>
            <div data-action="filtrev" data-type="room">{{localize 'Liber.Character.Inventory.Room'}} : {{actor.system.piece}} / {{actor.system.maxpiece}}</div>
        </div>
      <ul class="inventaire" "style="height: 256px;">
      {{#each visibleItemsV as |item id|}} 
          <li class="item fexrow type-{{item.type}} draggable" data-item-id="{{item._id}}" style="background:url({{item.img}}) center center no-repeat;background-size:50%; {{#if (eq item.system.equip 'pilote')}}border: solid 1px var(--couleur-bleuelect){{/if}}" title="{{stripHTML item.system.biography}}{{#if (eq item.type "weapon")}} | Porter:{{item.system.degat}} | Dommage: {{item.system.degat}}{{/if}}{{#if (eq item.type "armor")}}| Protection:{{item.system.protec}}{{/if}} [ {{item.system.valeur}}Cr ]">
            <div class="item-qty">{{item.system.quantity}}</div>
            <div class="item-weigth">{{item.system.degat}}</div>
            <div class="item-name">{{item.name}}</div>
            <div class="zonecontroledroit">
              <a class="item-control item-edit" title="Edit Item" data-action="edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Delete Item" data-action="delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
            </div>
            <div class="zonecontrolegauche">
              <span class="item-control pilote" title="{{localize 'Liber.Character.Pilote'}}" data-action="equip" data-ou="pilote" data-item-id="{{item._id}}" style="opacity: {{#if (eq item.system.equip 'pilote')}}1{{else}}0.5{{/if}}">></span>
            </div>
          </li>
      {{/each}}
      <ul>
        
    </div>
    
</div>